{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker this project deploys to. When this file is missing,
  // wrangler generates one during the build and names the self-reference
  // binding after package.json ("core-cs-interview-academy"), which doesn't
  // exist as a Worker — that's the 10143 deploy error.
  "name": "corecs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
